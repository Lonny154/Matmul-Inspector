{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matmul Inspector clock-aware paired comparison v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload",
    "seed",
    "correctness",
    "benchmark",
    "timeout_seconds",
    "kernels"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m",
        "n",
        "k",
        "dtype"
      ],
      "properties": {
        "m": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "dtype": {
          "const": "float16"
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atol",
        "rtol"
      ],
      "properties": {
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "warmups",
        "iterations",
        "rounds"
      ],
      "properties": {
        "mode": {
          "const": "preallocated"
        },
        "warmups": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "rounds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 20
        }
      }
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600
    },
    "kernels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "oneOf": [
            {
              "$ref": "#/$defs/registered_kernel"
            },
            {
              "$ref": "#/$defs/trusted_local_kernel"
            }
          ]
        },
        "B": {
          "oneOf": [
            {
              "$ref": "#/$defs/registered_kernel"
            },
            {
              "$ref": "#/$defs/trusted_local_kernel"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "registered_kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "parameters"
      ],
      "properties": {
        "implementation": {
          "const": "triton_fc1"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_m",
            "block_n",
            "block_k",
            "num_warps",
            "num_stages",
            "group_size_m"
          ],
          "properties": {
            "block_m": {
              "type": "integer",
              "minimum": 1
            },
            "block_n": {
              "type": "integer",
              "minimum": 1
            },
            "block_k": {
              "type": "integer",
              "minimum": 1
            },
            "num_warps": {
              "type": "integer",
              "minimum": 1
            },
            "num_stages": {
              "type": "integer",
              "minimum": 1
            },
            "group_size_m": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "trusted_local_kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "parameters",
        "source"
      ],
      "properties": {
        "implementation": {
          "const": "triton_source"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_m",
            "block_n",
            "block_k",
            "num_warps",
            "num_stages",
            "group_size_m"
          ],
          "properties": {
            "block_m": {
              "type": "integer",
              "minimum": 1
            },
            "block_n": {
              "type": "integer",
              "minimum": 1
            },
            "block_k": {
              "type": "integer",
              "minimum": 1
            },
            "num_warps": {
              "type": "integer",
              "minimum": 1
            },
            "num_stages": {
              "type": "integer",
              "minimum": 1
            },
            "group_size_m": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "entry_point",
            "interface_version"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "entry_point": {
              "const": "matmul_into"
            },
            "interface_version": {
              "const": "matmul_into_v1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "original_path": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$comment": "Version 3 uses the v2 preallocated kernel contract and adds matched RAW timing, host-clock preflight, and A/A controls to output artifacts. Python validation enforces additional bounds and source identity."
}
